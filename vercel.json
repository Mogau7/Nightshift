{
  "services": {
    "backend": {
      "root": "nightshift/backend",
      "runtime": "rust",
      "entrypoint": "src/main.rs"
    },
    "frontend": {
      "root": "nightshift/frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
